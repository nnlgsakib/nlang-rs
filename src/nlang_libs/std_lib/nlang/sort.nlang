export def sort(a) {
    @mut store n = len(a);
    @mut store swapped = true;
    while (swapped) {
        swapped = false;
        for (@mut store i = 1; i < n; i = i + 1) {
            if (a[i - 1] > a[i]) {
                @mut store tmp = a[i - 1];
                a[i - 1] = a[i];
                a[i] = tmp;
                swapped = true;
            }
        }
        n = n - 1;
    }
    return a;
}