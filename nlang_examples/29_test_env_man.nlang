import std;
from env_man import get, set, unset, list, os, load_env;

def main() {
    println("=== env_man Test ===");
    
    store os_name = os();
    println("OS: []", os_name);
    
    println("Setting TEST_VAR...");
    set("TEST_VAR", "Hello Nlang");
    
    store val = get("TEST_VAR");
    println("TEST_VAR: []", val);
    
    if (val == "Hello Nlang") {
        println("PASS: Set/Get working");
    } else {
        println("FAIL: Set/Get failed");
    }
    
    println("Unsetting TEST_VAR...");
    unset("TEST_VAR");
    
    store val_after = get("TEST_VAR");
    println("TEST_VAR after unset: '[]'", val_after);
    
    if (val_after == "") {
        println("PASS: Unset working");
    } else {
        println("FAIL: Unset failed");
    }
    
    println("Listing vars...");
    store all_vars = list();
    println("List returned successfully.");

    println("--- Testing load_env ---");
    println("Loading env from test.env...");
    load_env("D:/projects/rust/nlang/nlang_examples/test.env");
    store val_file = get("FILE_VAR");
    println("FILE_VAR: []", val_file);
    if (val_file == "LoadedFromFile") {
        println("PASS: load_env working");
    } else {
        println("FAIL: load_env failed");
    }
}
