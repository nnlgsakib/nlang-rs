// Static float tests: f32/f64 types and scientific notation
import std;

// Helper function for demonstration
def add_numbers(a: int, b: int) -> int {
    return a + b;
}

def main() {
    store a: f32 = 3.14;
    store b: f64 = 2.718281828;
    store c = 1.2e3; // defaults to f64

    store s: f64 = a + 2; // f32 + int -> f64
    store d: f64 = a + b; // f32 + f64 -> f64
    store f: f64 = 1.0e-3; // scientific notation literal defaults to f64

    println(a);
    println(b);
    println(c);
    println(s);
    println(d);
    println(f);
    
    // Using local function
    store sum_result = add_numbers(10, 5);
    print("10 + 5 = ");
    println(sum_result);
}