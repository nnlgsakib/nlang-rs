sub mod effects;

// Effects submodule - uses game module for character data (cross-module calls)
import game;
import utils;

export def show_damage_effect(damage: int, target_name: string) {
    println("💥 [] takes [] damage!", target_name, damage);
}

export def show_heal_effect(amount: int, target_name: string) {
    println("💚 [] heals [] HP!", target_name, amount);
}

export def show_level_up_effect(name: string, new_level: int) {
    println("╔═══════════════════════════════╗");
    println("║ 🎉 [] LEVELED UP!", name);
    println("║    New Level: []", new_level);
    store new_max_health = game.stats.calculate_max_health(new_level);
    println("║    Max HP: []", new_max_health);
    store new_defense = game.stats.calculate_defense(15, new_level);
    println("║    Defense: []", new_defense);
    println("╚═══════════════════════════════╝");
}

export def show_battle_result(player_name: string, enemy_name: string, player_hp: int, enemy_hp: int) {
    println("------- Battle Status -------");
    println("| []: [] HP", player_name, player_hp);
    println("| []: [] HP", enemy_name, enemy_hp);
    println("-----------------------------");
}

export def show_critical_hit() {
    println("⚡⚡⚡ CRITICAL HIT! ⚡⚡⚡");
}

export def show_miss() {
    println("💨 Attack missed!");
}

export def show_victory(winner_name: string, exp_gained: int) {
    println("════════════════════════════════");
    println("🏆 [] WINS!", winner_name);
    println("   EXP gained: +[]", exp_gained);
    println("════════════════════════════════");
}