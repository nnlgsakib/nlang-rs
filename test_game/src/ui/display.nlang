sub mod display;

// Display submodule - uses game.character (cross-module call)

export def show_welcome() {
    println("╔════════════════════════════════════╗");
    println("║       Welcome to NLang Game!       ║");
    println("╚════════════════════════════════════╝");
}

export def show_character_info(name: string, level: int, health: int) {
    println("┌──────────────────────────────────┐");
    print("│ Character: ");
    println(name);
    print("│ Level: ");
    println(level);
    print("│ Health: ");
    println(health);
    println("└──────────────────────────────────┘");
}

export def show_stats_panel(attack: int, defense: int, luck: int) {
    println("╭─────── Stats Panel ───────╮");
    print("│ Attack:  ");
    println(attack);
    print("│ Defense: ");
    println(defense);
    print("│ Luck:    ");
    println(luck);
    println("╰───────────────────────────╯");
}

export def show_separator() {
    println("────────────────────────────────────");
}

export def show_section_header(title: string) {
    print("══════ ");
    print(title);
    println(" ══════");
}

// Cross-module call: ui.display calls utils.formatter
export def show_health_display(current: int, max_hp: int) {
    println("Health Status:");
    utils.formatter.format_health_bar(current, max_hp);
    utils.formatter.format_percentage(current, max_hp);
}

// Cross-module call: ui.display calls game.stats
export def show_computed_damage(base_atk: int, level: int) {
    store damage = game.stats.calculate_damage(base_atk, 2);
    print("Computed damage: ");
    println(damage);
}
