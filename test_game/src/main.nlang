import std;
import game;
import ui;
import utils;

def main() {
    // Welcome screen using UI module
    ui.display.show_welcome();
    println("");
    
    // Create character using game module
    store player_name = game.character.create_character("Hero");
    store player_level = 5;
    
    // Calculate health using game.stats (same-module call from character to stats)
    store health = game.character.get_health();
    store max_health = game.stats.calculate_max_health(player_level);
    
    // Show character info using UI module (cross-module: ui uses data from game)
    ui.display.show_character_info(player_name, player_level, max_health);
    println("");
    
    // Calculate stats using game.stats module
    store total_stats = game.character.get_character_stats(player_level);
    store attack = 15;
    store defense = game.stats.calculate_defense(10, player_level);
    store luck = 25;
    
    // Show stats panel
    ui.display.show_stats_panel(attack, defense, luck);
    println("");
    
    // Use utils module for calculations
    store clamped_luck = utils.math_helper.clamp(luck, 0, 100);
    store crit_chance = game.stats.calculate_critical_chance(clamped_luck);
    
    // Show formatted health bar using utils.formatter
    println("Health Bar:");
    utils.formatter.format_health_bar(health, max_health);
    println("");
    
    // Show damage calculation
    store base_damage = game.character.get_damage(attack, player_level);
    store is_crit = crit_chance > 10;
    utils.formatter.format_damage_text(base_damage, is_crit);
    println("");
    
    // Show experience info
    store current_exp = 350;
    store needed_exp = game.character.level_up_info(player_level);
    utils.formatter.format_level_progress(current_exp, needed_exp);
    println("");
    
    // Test std library functions - sum, min, max, pow
    println("=== Using std library ===");
    store scores: [int; 5] = [85, 92, 78, 95, 88];
    println("Scores sum: []", sum(scores));
    println("Min score: []", min(scores));
    println("Max score: []", max(scores));
    println("pow(2, 8): []", pow(2, 8));
    println("");
    
    // Test utils.math_helper functions
    println("=== Using utils.math_helper ===");
    store test_scores = utils.math_helper.sum_array(scores);
    println("Manual sum: []", test_scores);
    store avg = utils.math_helper.average(85, 92, 78);
    println("Average of 85, 92, 78: []", avg);
    store scaled = utils.math_helper.scale_value(100, 150);
    println("100 scaled by 150%: []", scaled);
    println("");
    
    // Show main menu using ui.menu (same-module call: menu uses display)
    ui.menu.show_main_menu();
    
    // Emote actions
    println("Emote Actions:");
    game.emotes.wave();
    game.emotes.dance();
    game.emotes.cheer();
    println("");
    
    // Game over screen
    ui.menu.show_game_over();
    
    // === Cross-module complexity tests ===
    println("");
    println("=== Cross-Module Complexity Tests ===");
    
    // Test 1: ui.display calls utils.formatter (cross-module from submodule)
    println("Test 1: ui.display -> utils.formatter:");
    ui.display.show_health_display(75, 100);
    println("");
    
    // Test 2: ui.display calls game.stats (cross-module from submodule)  
    println("Test 2: ui.display -> game.stats:");
    ui.display.show_computed_damage(20, 5);
    println("");
    
    // Test 3: game.emotes calls game.inventory (sibling submodule call)
    println("Test 3: game.emotes -> game.inventory (sibling):");
    store item_powers: [int; 5] = [50, 35, 80, 25, 60];
    game.emotes.hype_character(player_name, item_powers);
    println("");
    
    // Test 4: Direct inventory access from main
    println("Test 4: Direct inventory access:");
    store total_pwr = game.inventory.total_power(item_powers);
    println("Total inventory power: []", total_pwr);
    store has_legendary = game.inventory.has_legendary_item(item_powers);
    println("Has legendary item: []", has_legendary);
    println("");
    
    println("=== All Cross-Module Tests Passed ===");
    
    println("");
    println("=== File System Integration Tests (fs_man) ===");
    
    println("Test 5: Save/Load System:");
    utils.save_manager.create_save_directory();
    utils.save_manager.save_player_data(player_name, player_level, health);
    utils.save_manager.backup_save_file(player_name);
    store loaded_data = utils.save_manager.load_player_data(player_name);
    println("Loaded data preview: []", loaded_data);
    store save_size = utils.save_manager.get_save_file_size(player_name);
    store save_count = utils.save_manager.list_save_files();
    println("Total save files: []", save_count);
    println("");
    
    println("Test 6: Configuration System:");
    utils.config_manager.create_config_directory();
    utils.config_manager.save_settings(1920, 1080, 75);
    store settings = utils.config_manager.load_settings();
    utils.config_manager.get_config_info();
    println("");
    
    println("Test 7: Game Paths & Temp Files:");
    utils.config_manager.get_game_paths();
    store autosave = utils.save_manager.create_temp_save(player_name);
    utils.config_manager.clean_temp_files();
    println("");
    
    println("Test 8: Log Export:");
    utils.config_manager.export_game_logs();
    println("");
    
    println("=== File System Tests Complete ===");
}